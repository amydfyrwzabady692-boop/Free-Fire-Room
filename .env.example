# =============================================================================
# Free Fire Room — environment template
# Copy to .env and fill values. NEVER commit real secrets.
# =============================================================================

APP_ENV=development
APP_NAME=Free Fire Room
APP_SECRET_KEY=change-me-to-a-64-char-random-string
DEBUG=true
LOG_LEVEL=INFO
TZ=UTC
DEFAULT_TIMEZONE=Asia/Tehran
DEFAULT_LOCALE=fa

# Public URLs
PUBLIC_BASE_URL=http://localhost:8080
API_BASE_URL=http://localhost:8080/api
FRONTEND_BASE_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Telegram
BOT_TOKEN=
BOT_USERNAME=your_bot_username
TELEGRAM_MODE=polling
WEBHOOK_PATH=/telegram/webhook
WEBHOOK_SECRET=change-me-webhook-secret
TELEGRAM_LOGIN_BOT_DOMAIN=localhost

# Super admin — روی VPS با ./deploy.sh از همین مقادیر ساخته می‌شود
# شناسه عددی تلگرام (از @userinfobot بگیر)
BOOTSTRAP_SUPERADMIN_TELEGRAM_ID=
BOOTSTRAP_SUPERADMIN_PASSWORD=

# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ffroom
POSTGRES_USER=ffroom
POSTGRES_PASSWORD=change-me-db-password
DATABASE_URL=postgresql+asyncpg://ffroom:change-me-db-password@postgres:5432/ffroom
DATABASE_SYNC_URL=postgresql+psycopg://ffroom:change-me-db-password@postgres:5432/ffroom

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Encryption (Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ROOM_CREDENTIALS_KEY=
# Optional separate key for backups; defaults to ROOM_CREDENTIALS_KEY
BACKUP_ENCRYPTION_KEY=

# Sessions / JWT
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=20
REFRESH_TOKEN_EXPIRE_DAYS=7
ADMIN_SESSION_IDLE_MINUTES=30
OTP_EXPIRE_SECONDS=300
OTP_MAX_ATTEMPTS=5

# Rate limits
RATE_LIMIT_START_PER_MINUTE=8
RATE_LIMIT_MEMBERSHIP_PER_MINUTE=12
RATE_LIMIT_REGISTER_PER_MINUTE=6
RATE_LIMIT_REFERRAL_PER_MINUTE=10
RATE_LIMIT_LOGIN_PER_MINUTE=8
TELEGRAM_OUTBOUND_PER_SECOND=25

# Uploads
MAX_UPLOAD_MB=5
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# Data retention (days). 0 = keep until explicit purge job.
ROOM_CREDENTIALS_RETENTION_DAYS=7
AUDIT_LOG_RETENTION_DAYS=365
DELIVERY_LOG_RETENTION_DAYS=90
SOFT_DELETE_PURGE_DAYS=180

# Feature flags / policy defaults
EVENT_APPROVAL_REQUIRED=true
MAX_EVENTS_PER_ORGANIZER=10
MAX_REQUIRED_CHANNELS_PER_EVENT=5
MAX_REQUIRED_REFERRALS=20
MAINTENANCE_MODE=false
OPENAPI_ENABLED=true

# Observability (optional)
SENTRY_DSN=
PROMETHEUS_ENABLED=true

# Nginx / TLS (production)
TLS_CERT_PATH=/etc/nginx/certs/fullchain.pem
TLS_KEY_PATH=/etc/nginx/certs/privkey.pem
